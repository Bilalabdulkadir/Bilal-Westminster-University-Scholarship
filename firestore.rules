rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for UserSocials
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email'])
        && data.keys().size() <= 8
        && data.id == request.auth.uid
        && data.email == request.auth.token.email
        && (data.linkedin is string && data.linkedin.size() <= 500)
        && (data.github is string && data.github.size() <= 500)
        && (data.twitter is string && data.twitter.size() <= 500)
        && (data.other is string && data.other.size() <= 500);
    }

    // User collection match
    match /users/{userId} {
      allow get: if true;
      allow list: if false; // Block listing of all users
      allow create: if isOwner(userId)
                    && isValidUser(incoming()) 
                    && incoming().createdAt == request.time 
                    && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
                    && isValidUser(incoming())
                    && incoming().updatedAt == request.time
                    && incoming().createdAt == existing().createdAt
                    && incoming().email == existing().email
                    && incoming().diff(existing()).affectedKeys().hasOnly(['linkedin', 'github', 'twitter', 'other', 'updatedAt']);
      allow delete: if false;
    }
  }
}
